# ===== Ethara Backend (Express API) =====
PORT=4000
NODE_ENV=development

# --- Database (MongoDB) ---
PROD_DATABASE_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ethara
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ethara

# --- JWT secret (keep identical across redeploys; generate a long random string) ---
TOKEN_SECRET=replace_with_a_long_random_secret

# --- CORS: comma-separated allowed frontend origins ---
FRONTEND_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=info

# --- SMTP (optional; email verify / password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
# Used to build links inside emails (points at the FRONTEND)
DOMAIN_URL=http://localhost:5173
