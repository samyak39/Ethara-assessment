# Base URL of the Express backend API (must end in /api)

# Local development (backend running on your machine):
VITE_API_URL=http://localhost:4000/api

# Production — deployed backend on Render:
# VITE_API_URL=https://ethara-backend-2963.onrender.com/api
#
# On Render, set VITE_API_URL in the Static Site's Environment settings to the
# production value above (Vite bakes it in at build time).
